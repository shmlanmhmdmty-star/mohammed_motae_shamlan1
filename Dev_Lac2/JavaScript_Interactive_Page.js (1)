function square() {
    let x = 5;
    let s = gets(x);

    let ee = document.getElementById("btn");
    ee.innerText = s;

    return s;
}

function gets(y) {
    return y * y;
}

document.write("<br/>");


function showMenu() {
    let menu = document.getElementById("sweetsContainer");
    menu.style.display = "block";
    menu.style.background = "#fff7ed";
    menu.style.borderColor = "#ea580c";
}

function hideMenu() {
    let menu = document.getElementById("sweetsContainer");
    menu.style.display = "none";
}


function showDate() {
    let date = document.getElementById("btn2");
    let currentDate = new Date();
    date.innerText = currentDate.toLocaleString();
}

document.write("<br/>");


function addNewElement() {
    let box = document.getElementById("myBox");
    let newP = document.createElement("p");
    let result = square();

    newP.textContent = "مربع العدد هو: " + result;
    newP.style.color = "#075985";
    newP.style.border = "2px solid #38bdf8";
    newP.style.padding = "12px";
    newP.style.borderRadius = "10px";
    newP.style.backgroundColor = "#e0f2fe";
    newP.style.boxShadow = "0 4px 8px rgba(0, 0, 0, 0.1)";

    box.appendChild(newP);
}


